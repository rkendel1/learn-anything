# Set this after running `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=

# Convex Auth signing keys also belong in the Convex deployment, NOT here:
# npm run auth:keys
# cat .auth/jwt_private_key.pem | npx convex env set --force JWT_PRIVATE_KEY
# cat .auth/jwks.json | npx convex env set --force JWKS

# Server-side agent configuration belongs in the Convex deployment, NOT here.
# npx convex env set AI_GATEWAY_API_KEY
# (prompts securely for the value; add --prod for production)
# Optional model overrides in Convex:
# npx convex env set AI_MODEL openai/o4-mini
# npx convex env set AI_REASONING_MODEL openai/o4-mini
